# Build output
bin/
obj/
.artifacts/
*.user
*.suo

# Generated by the FlowX compiler — readable on disk for debugging (ADR-0002),
# but a build output, not source.
**/obj/generated/
flowx.manifest.json

# Test and coverage
TestResults/
coverage*.xml
*.coverage
BenchmarkDotNet.Artifacts/

# Local tooling state. Never committed: a .claude/ or CLAUDE.md in the repository
# is a tool artefact, not part of the product.
.claude/
CLAUDE.md
.vs/
.idea/
.vscode/
*.swp
.DS_Store

# Local infrastructure from `flowx dev up`
docker-compose.override.yml
.env.local

# Byte code from the checkers under scripts/. Importing one checker from another —
# which check-journal-benchmarks-selftest.py does, because the checker's filename is not
# an identifier — is enough to make CPython write it.
__pycache__/
*.pyc

# Redis snapshots written by a locally started redis-server during testing.
# The lease-store suite needs a live Redis; its default save behaviour drops a
# dump.rdb in whatever directory the server was started from.
dump.rdb
*.rdb
